export interface CatalogProduct {
  id: string;
  sku: string;
  slug: string;
  name: string;
  nameAr?: string;
  categoryId: 'cadeaux' | 'maison-bureau' | 'accessoires' | 'decoration' | 'professionnels' | 'mariages-fetes';
  categoryLabel: string;
  priceCents: number | null; // Minor units (e.g. 4900 = 49.00 MAD). null = Sur devis B2B
  pricingMode: 'fixed' | 'quote' | 'starting_at';
  featured: boolean;
  bestseller?: boolean;
  shortDescription: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  isRealPhoto: boolean;
  palettes: Array<{
    id: string;
    label: string;
    colors: string[]; // 2 to 4 HEX colors
  }>;
  dimensionsMm: { width: number; depth: number; height: number };
  bambuSpecs: {
    printTimeMinutes: number;
    filamentGrams: number;
    layerHeightMm: number;
    nozzleMm: number;
    amsColorCount: number;
    supportsRequired: boolean;
  };
  customizationSchema: {
    kind: 'name_bilingual' | 'text' | 'qr' | 'monogram' | 'none';
    maxGraphemes?: number;
    bespoke?: boolean;
    supportsArabic?: boolean;
  };
}

